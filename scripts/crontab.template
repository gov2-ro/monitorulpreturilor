# Crontab template for monitorulpreturilor.
#
# Install: `crontab scripts/crontab.template` (or copy lines into `crontab -e`).
# Healthchecks.io UUIDs for retail, gas, reference, audit are baked in below.

SHELL=/bin/bash

# Retail prices — re-entrant every 30 min, ~28 min/slice.
# The script's lock + checkpoint make this a no-op when a slice is already in
# flight or the day's session is complete. Recovery from any kill drops from
# 24h to ~30 min. Health is checked separately at 07:05 to keep this line quiet
# (would otherwise be 48 hc pings/day). See docs/pipeline-cadence.md.
*/30 * * * * cd /home/pax/g2-dev/monitorulpreturilor && source venv/bin/activate && python fetch_prices.py --max-runtime 1700 >> data/logs/fetch-prices.log 2>&1

# Retail health ping — daily 07:05. check_runs honors the per-script lock, so a
# slice-in-flight isn't false-failed. 36h window gives room for a session that
# spans more than a calendar day under the new re-entrant scheme.
5 7 * * * cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh 48b9dd2d-f5a1-4947-a154-e3aaa0f079da bash -c 'source venv/bin/activate && python check_runs.py --script fetch_prices --max-age-hours 36 >> data/logs/check-runs.log 2>&1'

# Gas prices — daily 03:40 (delayed past the 03:00 retail+reference window; WAL+busy_timeout=60s handles any residual overlap)
40 3 * * * cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh d5454af9-13f6-44a4-9771-200426385592 bash -c 'source venv/bin/activate && python fetch_gas_prices.py >> data/logs/fetch-gas-prices.log 2>&1 && python check_runs.py --script fetch_gas_prices --max-age-hours 25 >> data/logs/check-runs.log 2>&1'

# Daily audit — 06:00, after both fetchers have had time to start
0 6 * * * cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh a440ce9b-0547-406f-836a-0570e0737fc6 bash -c 'source venv/bin/activate && python audit_pipeline.py >> data/logs/audit.log 2>&1 && python generate_pipeline_report.py >> data/logs/audit.log 2>&1'

# Audit RED alert — 06:02, exits 1 when audit is RED (triggers HC.io fail notification).
# Create a check at healthchecks.io.com (period=1d, grace=30m) and paste its UUID below.
2 6 * * * cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh REPLACE_WITH_HC_UUID bash -c 'source venv/bin/activate && python scripts/alert_red.py >> data/logs/alert-red.log 2>&1'

# Pipeline-check RED alert — 07:15, reads the most recent on-demand pipeline-check verdict
# (written by /pipeline-check to data/logs/pipeline-check.log). Exits 1 if last entry
# within 25h has Verdict: RED. Create a HC.io check (period=1d, grace=2h) and paste UUID.
15 7 * * * cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh REPLACE_WITH_PIPELINE_CHECK_HC_UUID bash -c 'source venv/bin/activate && python scripts/alert_pipeline_check.py >> data/logs/alert-pipeline-check.log 2>&1'

# Site rebuild + publish — 06:30, after the daily audit at 06:00 so pipeline-health.html
# carries fresh numbers. Builds the aggregators, regenerates all pages, then force-pushes
# site/ to the gh-pages branch (GitHub Pages cannot serve an arbitrary /site folder from
# main). Runs long — generate_site.py aggregates the full price history — so it deliberately
# sits between the audit and the 07:05 retail health ping rather than near the 30-min
# fetch_prices ticks. SQLite is in WAL mode, so a concurrent fetch is not blocked.
# Create a HC.io check (period=1d, grace=3h) and paste its UUID below.
30 6 * * * cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh REPLACE_WITH_PUBLISH_SITE_HC_UUID bash -c 'scripts/publish_site.sh >> data/logs/publish-site.log 2>&1'

# Reference refresh — Monday 03:00
0 3 * * 1 cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh 09407697-7ace-4ebb-ad25-ef2e48c02c21 bash -c 'source venv/bin/activate && python fetch_reference.py >> data/logs/fetch-reference.log 2>&1 && python fetch_gas_reference.py >> data/logs/fetch-gas-reference.log 2>&1'

# Sentinel refresh — Sunday 04:00. Re-picks Tier-A sentinel stores from the last 30 days
# of data (data/sentinel_stores.json). This was a manual step nobody re-ran after
# 2026-06-23, which let two of the four sentinel sets (LIDL, SUPECO) sit on stores whose
# upstream price_date had silently frozen for months (see docs/backlog.md, frozen_price_dates
# audit check). fetch_prices.py's SENTINEL_FROZEN_DATE_DAYS guard now refuses to propagate a
# frozen sentinel regardless, but a fresher sentinel avoids losing that network's Tier-A
# fetch savings. Create a HC.io check (period=7d, grace=1h) and paste its UUID below.
0 4 * * 0 cd /home/pax/g2-dev/monitorulpreturilor && scripts/hc_run.sh REPLACE_WITH_SENTINEL_REFRESH_HC_UUID bash -c 'source venv/bin/activate && python analyze_price_similarity.py --days 30 --export-sentinels data/sentinel_stores.json >> data/logs/sentinel-refresh.log 2>&1'

# DB backup — Sunday 10:00 (after the daily retail pass completes ~08:41). Compressed,
# lock-safe (sqlite3 .dump | gzip), keeps last 2. Restore + off-box notes in the script.
0 10 * * 0 cd /home/pax/g2-dev/monitorulpreturilor && scripts/backup_db.sh >> data/logs/backup.log 2>&1

# Log rotation — daily 10:30, size-based (rotates only logs >50M). copytruncate keeps
# the long-lived fetch_prices fd valid. See scripts/logrotate.conf.
30 10 * * * cd /home/pax/g2-dev/monitorulpreturilor && /usr/sbin/logrotate -s data/logs/.logrotate.state scripts/logrotate.conf >> data/logs/logrotate.log 2>&1

# Sumal (different project) — left untouched
0 */3 * * * cd /home/pax/g2-dev/prometeu && source /home/pax/g2-dev/monitorulpreturilor/venv/bin/activate && python sumal-inspectorul-padurii.py >> ~/g2-dev/logs/sumal.log 2>&1; curl -m 10 https://hc-ping.com/0b3b2149-dd3f-4842-8dd4-c91e3c1df74b
